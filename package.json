{
	"name": "lemons-search",
	"version": "0.5.10",
	"description": "A blazingly fast fuzzy finder with file preview.",
	"main": "main.js",
	"scripts": {
		"build:wasm": "cd packages/lemons-search && wasm-pack build --target web --scope lemons_dev",
		"dev": "vite build --mode=development --watch",
		"dev:local": "bun run build:wasm && LEMONS_SEARCH_LOCAL_WASM=true vite build --mode=development --watch",
		"build": "vite build --mode=production",
		"build:local": "bun run build:wasm && LEMONS_SEARCH_LOCAL_WASM=true vite build --mode=production",
		"typecheck": "tsc -noEmit -skipLibCheck",
		"test": "bun test",
		"test:log": "LOG_TESTS=true bun test",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint . --report-unused-disable-directives",
		"lint:fix": "eslint . --fix --report-unused-disable-directives",
		"check": "bun run format:check && bun run typecheck && bun run typecheck:tools && bun run svelte-check && bun run lint && bun run test",
		"release": "bun run release:prepare",
		"lint:review": "eslint . --config eslint.review.config.mjs",
		"svelte-check": "svelte-check --tsconfig ./tsconfig.json",
		"verify": "bun run check && bun run build && lemons-automation validate",
		"release:prepare": "lemons-automation release:prepare",
		"package": "bun run build && lemons-automation package",
		"typecheck:tools": "tsc --noEmit -p tsconfig.tools.json"
	},
	"keywords": [],
	"author": "Moritz Jung",
	"license": "GPL-3.0",
	"devDependencies": {
		"@happy-dom/global-registrator": "^20.10.6",
		"@lemons_dev/lemons-obsidian-plugin-automation": "https://github.com/mProjectsCode/lemons-obsidian-plugin-helpers/releases/download/automation-v0.2.8/automation-v0.2.8.tgz",
		"@lemons_dev/parsinom": "^0.2.1",
		"@sveltejs/vite-plugin-svelte": "7.1.2",
		"@types/bun": "1.3.14",
		"eslint": "9.39.4",
		"eslint-plugin-svelte": "^3.19.0",
		"obsidian": "latest",
		"obsidian-typings": "^6.15.0",
		"prettier": "3.9.4",
		"svelte": "5.56.3",
		"svelte-check": "4.6.0",
		"tslib": "^2.8.1",
		"typescript": "6.0.3",
		"vite": "8.1.3",
		"@lemons_dev/eslint-config-obsidian": "https://github.com/mProjectsCode/lemons-obsidian-plugin-helpers/releases/download/eslint-config-v0.1.5/eslint-config-v0.1.5.tgz",
		"@types/node": "25.5.0",
		"prettier-plugin-svelte": "4.1.1"
	},
	"dependencies": {
		"@lemons_dev/lemons-search": "https://github.com/mProjectsCode/obsidian-lemons-search-wasm/releases/download/v0.1.7/lemons-search-v0.1.7.tgz"
	},
	"packageManager": "bun@1.4.0",
	"overrides": {
		"typescript": "6.0.3",
		"typescript-eslint": "8.61.1"
	}
}
